# Copy this file to .env and adjust.

# Port the website + API server listens on.
PORT=3000

# Which ERP adapter to use (see server/erp/adapter.ts).
#   local = store orders/enquiries in JSON files in DATA_DIR (development only:
#           nobody is notified of new orders).
ERP_ADAPTER=local
DATA_DIR=data

# Set to true when running behind a reverse proxy (Nginx, Cloudflare, a PaaS
# load balancer) so rate limiting sees each visitor's real IP address.
TRUST_PROXY=false

# Settings for the real ERP adapter, once it is written. Never commit real keys.
# ERP_API_URL=
# ERP_API_KEY=

# Public address of the website, used in sitemap.xml (no trailing slash).
# SITE_URL=https://www.example.com
